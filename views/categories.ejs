
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | Computer Store</title>
    <style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f6f9;
        color: #1f2937;
        margin: 0;
        padding: 2rem 5%;
    }

    h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 1.5rem;
    }

    .filter-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}

.filter-form input {
    flex: 1;
    min-width: 12rem;
    padding: 0.75rem;
    font-size: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    box-sizing: border-box;
}

.filter-form button {
    padding: 0.75rem 1.25rem;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 1rem;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
}

.filter-form button:hover {
    background-color: #1d4ed8;
}

.filter-form a {
    padding: 0.75rem;
    color: #4b5563;
    text-decoration: none;
}

.filter-form a:hover {
    color: #2563eb;
    text-decoration: underline;
}
.add-category-btn {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color 0.2s ease;
}

.add-category-btn:hover {
    background-color: #1d4ed8;
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
}

.category-card {
    background-color: #ffffff;
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
    min-width: 0;
}

.category-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-top: 0;
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
}

.category-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4b5563;
    margin-top: 0;
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
}

.category-card .action-link,
.category-card .delete-btn {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.view-link {
    background-color: #dbeafe;
    color: #1d4ed8;
}

.view-link:hover {
    background-color: #bfdbfe;
}

.edit-link {
    background-color: #f3f4f6;
    color: #374151;
}

.edit-link:hover {
    background-color: #e5e7eb;
}

.delete-form {
    display: inline-block;
    margin-top: 0.75rem;
}

.delete-btn {
    background-color: #fee2e2;
    color: #b91c1c;
    border: none;
}

.delete-btn:hover {
    background-color: #fecaca;
}

.pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
}

.page-link {
    padding: 0.65rem 1rem;
    background-color: #ffffff;
    color: #2563eb;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s ease;
}

.page-link:hover {
    background-color: #dbeafe;
}

.page-info {
    color: #4b5563;
    font-size: 0.95rem;
}
</style>
</head>
<body>
    <h1>Computer Store Categories</h1>

    <form action="/categories" method="GET" class="filter-form">
        <input
            type="search"
            name="search"
            placeholder="Search categories by name..."
            value="<%= search %>"
        >
        <button type="submit">Search</button>
        <a href="/categories">Clear</a>
    </form>

  <a href="/categories/new" class="add-category-btn">
    + Add Category
</a>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <ul class="categories-grid">
        <% categories.forEach(category => { %>
            <li class="category-card">
                <h2><%= category.name %></h2>

                <p><%= category.description || "No description available." %></p>

<a href="/categories/<%= category.id %>" class="action-link view-link">View</a>
<a href="/categories/<%= category.id %>/edit" class="action-link edit-link">Edit</a>
               <form
    action="/categories/<%= category.id %>/delete"
    method="POST"
    class="delete-form"
    onsubmit="return confirm('Are you sure you want to delete this category?');"
>
                    <button type="submit" class="delete-btn">Delete</button>
                </form>
            </li>
        <% }) %>
    </ul>

    <div class="pagination">
        <% if (page > 1) { %>
            <a   class="page-link" href="/categories?search=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">
                Previous
            </a>
        <% } %>

        <span>Page <%= page %> of <%= totalPages %></span>

        <% if (page < totalPages) { %>
            <a class="page-link" href="/categories?search=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">
                Next
            </a>
        <% } %>
    </div>
</body>
</html>
