<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Item | Computer Store</title>
    <style>
       body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f6f9;
    color: #1f2937;
    margin: 0;
    padding: 2rem 5%;
}
        h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 24px;
    align-items: center;
}

.item-form {
    width: 100%;
    max-width: 37.5rem;
    margin: 0 auto;
    box-sizing: border-box;

    background-color: #ffffff;
    padding: 1.75rem;
    border-radius: 0.75rem;
    box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.05);
}
.item-form > div {
    margin-bottom: 1.25rem;
}

.item-form label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
}
.item-form input,
.item-form select,
.item-form textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem;
    font-size: 1rem;
    font-family: inherit;
    color: #1f2937;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
}
.item-form input:focus,
.item-form select:focus,
.item-form textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
}
.item-form textarea {
    min-height: 8rem;
    resize: vertical;
}
.item-form .submit-btn {
    width: 100%;
    padding: 0.85rem 1rem;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
}
.item-form .submit-btn:hover {
    background-color: #1d4ed8;
}
.back-link {
    display: block;
    width: fit-content;
    margin-left: auto;
    margin-bottom: 1.5rem;
    color: #2563eb;
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
}

.back-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
}
.back-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
}
</style>
</head>
<body>
    <h1>Add New Item</h1>
      <a href="/items" class="back-link">← Back to Inventory</a>
   <form action="/items/new" method="post" class="item-form">
        <div>
            <label for="name">Item Name:</label>
            <input type="text" name="name" id="name" required>
        </div>

        <div>
            <label for="description">Description:</label>
            <textarea name="description" id="description"></textarea>
        </div>

        <div>
            <label for="price">Price(ETB)</label>
            <input type="number" name="price" id="price" min="1" step="0.02" required>
        </div>
        <div>
            <label for="quantity">Quantity</label>
            <input type="number" name="quantity" id="quantity" min="1" step="1">
        </div>

        <div>
            <label for="sku">SKU</label>
            <input type="text" name="sku" id="sku" required>
        </div>
        <div>
            <label for="category_id">Category</label>
            <select name="category_id" id="category_id" required>
                <option value=""> Choose a Category</option>
                <% categories.forEach((category)=>{%>
                    <option value="<%= category.id%>">
<%= category.name%>
                    </option>
                <%})%>

            </select>
        </div>
<button type="submit" class="submit-btn">Add Item</button>
    </form>
    
  
</body>
</html>