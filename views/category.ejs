<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category | Computer Store</title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f9;
            color: #1f2937;
            margin: 0;
            padding: 2rem 5%;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #111827;
            text-align: center;
            margin-bottom: 1.5rem;
            overflow-wrap: anywhere;
        }

        .back-link {
            display: block;
            width: fit-content;
            margin-left: auto;
            margin-bottom: 1.5rem;
            color: #2563eb;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .back-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        .category-card {
            width: 100%;
            max-width: 37.5rem;
            margin: 0 auto;
            padding: 1.75rem;
            box-sizing: border-box;
            background-color: #ffffff;
            border-radius: 0.75rem;
            box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.05);
        }

        .category-card h2 {
            font-size: 1.25rem;
            color: #111827;
            margin-top: 0;
            margin-bottom: 0.75rem;
        }

        .category-card p {
            font-size: 1rem;
            line-height: 1.7;
            color: #4b5563;
            margin: 0;
            overflow-wrap: anywhere;
        }

        @media (max-width: 30rem) {
            body {
                padding: 1.25rem 4%;
            }

            h1 {
                font-size: 1.6rem;
            }

            .category-card {
                padding: 1.25rem;
            }
        }
    </style>
</head>

<body>
    <a href="/categories" class="back-link">
        ← Back to Categories
    </a>

    <h1>Category Details</h1>

    <section class="category-card">
        <h2>Description</h2>

        <p>
            <%= category.description || "No description available." %>
        </p>
    </section>
</body>
</html>
