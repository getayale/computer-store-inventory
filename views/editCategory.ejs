<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category | Computer Store</title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f9;
            color: #1f2937;
            margin: 0;
            padding: 2rem 5%;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #111827;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .back-link {
            display: block;
            width: fit-content;
            margin-left: auto;
            margin-bottom: 1.5rem;
            color: #2563eb;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
        }

        .back-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        .category-form {
            width: 100%;
            max-width: 37.5rem;
            margin: 0 auto;
            padding: 1.75rem;
            box-sizing: border-box;
            background-color: #ffffff;
            border-radius: 0.75rem;
            box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.05);
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .category-form label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #374151;
        }

        .category-form input,
        .category-form textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 0.75rem;
            font-family: inherit;
            font-size: 1rem;
            color: #1f2937;
            background-color: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
        }

        .category-form textarea {
            min-height: 8rem;
            line-height: 1.5;
            resize: vertical;
        }

        .category-form input:focus,
        .category-form textarea:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
        }

        .form-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        .submit-btn {
            flex: 1;
            padding: 0.85rem 1rem;
            background-color: #2563eb;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .submit-btn:hover {
            background-color: #1d4ed8;
        }

        .cancel-link {
            display: inline-block;
            padding: 0.85rem 1rem;
            background-color: #f3f4f6;
            color: #374151;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            border-radius: 0.5rem;
            box-sizing: border-box;
        }

        .cancel-link:hover {
            background-color: #e5e7eb;
        }

        @media (max-width: 30rem) {
            body {
                padding: 1.25rem 4%;
            }

            h1 {
                font-size: 1.6rem;
            }

            .category-form {
                padding: 1.25rem;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .submit-btn,
            .cancel-link {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <a href="/categories" class="back-link">
        ← Back to Categories
    </a>

    <h1>Edit Category</h1>

    <form
        action="/categories/<%= category.id %>/edit"
        method="POST"
        class="category-form"
    >
        <div class="form-group">
            <label for="name">Category Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= category.name %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="4"
            ><%= category.description || "" %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="submit-btn">
                Save Changes
            </button>

            <a href="/categories" class="cancel-link">Cancel</a>
        </div>
    </form>
</body>
</html>
